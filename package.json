{
  "name": "lexintegra",
  "version": "0.0.0",
  "private": true,
  "description": "LexIntegra — plataforma juridica de comercializacao e acompanhamento de produtos juridicos",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "scripts/emuladores.sh 'pnpm --parallel --filter \"./apps/*\" dev'",
    "build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build",
    "test": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" test",
    "test:integration": "scripts/emuladores.sh",
    "test:e2e": "pnpm --filter web test:e2e",
    "lint": "pnpm run lint:eslint && pnpm run lint:styles && pnpm run lint:deps",
    "lint:eslint": "eslint .",
    "lint:styles": "stylelint \"apps/web/src/**/*.css\"",
    "lint:deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "quality": "pnpm run lint && pnpm run test:coverage",
    "test:coverage": "pnpm --filter \"./apps/*\" --filter \"./packages/*\" test:coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:visual": "pnpm --filter web test:visual",
    "test:a11y": "pnpm --filter web test:a11y",
    "semear": "scripts/emuladores.sh 'node scripts/semear-emulador.mjs'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "angular-eslint": "^22.2.0",
    "dependency-cruiser": "^17.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.0",
    "firebase-admin": "^14.3.0",
    "firebase-tools": "^14.0.0",
    "prettier": "^3.6.2",
    "stylelint": "^17.14.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.46.2"
  }
}
