{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/block-dangerous.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(*scripts/manual-only/*)"
    ]
  }
}
