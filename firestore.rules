rules_version = '2';

// Nega tudo, por padrao e de proposito.
//
// Arquitetura, secao 6.1 e regra inviolavel 7: o SDK do Firebase no frontend serve
// SO para autenticacao. Nenhuma leitura ou escrita direta no Firestore pelo browser
// — todo acesso ao banco passa pela API, o que concentra a autorizacao em um lugar
// auditavel.
//
// As regras reais (perfis por custom claim, advogado enxergando apenas o que lhe
// foi distribuido) sao a Etapa 4, e cada uma exige teste correspondente no
// emulador, incluindo o caso negativo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
